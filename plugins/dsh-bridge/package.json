{
  "name": "@deepseek-ai/dsh-mobile-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Serves a paired phone an authenticated, policy-gated view of a local dsh workstation. Runs inside dsh web as a Cordis plugin, or standalone through bridge/src/cli.ts.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["dist", "panel-ui", "cordis.patch.yml", ".codex-plugin"],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
